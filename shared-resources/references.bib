% ===========================================================================
% MASTER BIBLIOGRAPHY - single source of truth for the whole research programme.
%
% Edit THIS file to add references, for BOTH the journal paper and the thesis.
% Do NOT edit the copies inside journal-paper/ or thesis-book/ - those are made
% by the sync step and overwritten every render.
%
% A .bib is a Quarto resource (the same category as a figure): it is synced INTO
% each writing project and never referenced with ../ . See the project README.
%
% Each document outputs only the references it actually cites, so the paper shows
% just its cited subset even though this file also holds the thesis references.
%
% IMPORTANT: the bibliography parser does NOT treat "%" as a comment for entries,
% so never paste an example entry inside a comment - it would be parsed and break
% the build. Keep comments to plain prose (ASCII only).
% ===========================================================================

% LIVE EXAMPLE ENTRY - delete once you add your own references. The template
% paper and thesis cite this key with [@example2024] so the chain renders a
% working reference list out of the box.
@article{example2024,
  author  = {Last, First and Other, Author},
  title   = {An example reference cited by both the paper and the thesis},
  journal = {Journal Name},
  year    = {2024},
  volume  = {1},
  number  = {1},
  pages   = {1--10},
  doi     = {10.0000/example}
}

% To add references: paste normal BibTeX entries below (one per work, each with a
% unique citation key) and cite them in prose with [@yourkey].
