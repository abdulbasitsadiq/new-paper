# ============================================================================
# .gitignore — new-paper
# Verified against current renv / Quarto / R conventions (Quarto 1.9, renv 1.x).
# Principle: track SOURCES (scripts, master references.bib, .qmd, configs,
# renv.lock); ignore INPUTS you supply and OUTPUTS/artifacts that regenerate.
# ============================================================================

# --- RAW & DERIVED DATA -- NEVER COMMIT (may be credentialed/patient-level) --
shared-resources/data/*
shared-resources/derived/*
!shared-resources/data/.gitkeep
!shared-resources/data/DATA_DICTIONARY.md
!shared-resources/data/ACCESS.md
!shared-resources/derived/.gitkeep

# --- GENERATED FIGURES (producer location, regenerated by scripts) ----------
shared-resources/figures/*
!shared-resources/figures/.gitkeep
!shared-resources/figures/PROVENANCE.txt
thesis-book/_book/

# --- SYNCED-IN RESOURCES (regenerated by _sync.R; edit the MASTER, not these) -
journal-paper/figures/*
!journal-paper/figures/.gitkeep
journal-paper/references.bib

# --- RENDER OUTPUTS ----------------------------------------------------------
journal-paper/*.pdf
journal-paper/*.docx
journal-paper/index_files/
.quarto/

# --- renv: ignore the library, KEEP renv.lock -------------------------------
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/python/
renv/sandbox/

# --- R / RStudio ------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# --- OS cruft ---------------------------------------------------------------
.DS_Store
Thumbs.db